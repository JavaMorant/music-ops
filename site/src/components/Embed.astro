---
// Renders one embed (SoundCloud / Mixcloud / Spotify audio, or a YouTube video).
// `title` shows a visible heading AND names the iframe; `label` names the iframe
// only. Provider sets the sizing; if it's missing we infer it from the embed URL.
interface Props {
  title?: string;
  label?: string;
  provider?: string;
  embedUrl: string;
}
const { title, label, embedUrl } = Astro.props;
const provider =
  Astro.props.provider ??
  (/open\.spotify\.com/.test(embedUrl) ? "spotify"
    : /youtube\.com|youtu\.be/.test(embedUrl) ? "youtube"
    : /mixcloud\.com/.test(embedUrl) ? "mixcloud"
    : "soundcloud");
const klass =
  provider === "youtube" ? "embed video"
  : provider === "spotify" ? "embed audio-tall"
  : provider === "mixcloud" ? "embed mixcloud"
  : "embed audio";
const allow =
  provider === "youtube"
    ? "accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    : "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
---
<div class={klass}>
  {title && <h3>{title}</h3>}
  <iframe
    src={embedUrl}
    title={title ?? label ?? "embedded media"}
    loading="lazy"
    allow={allow}
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
