---
// Renders one embed (SoundCloud / Spotify audio, or a YouTube video). `title`
// shows a visible heading AND names the iframe; `label` names the iframe only
// (used where the title is already shown elsewhere, e.g. Productions). Provider
// sets the sizing; if it's missing we infer it from the embed URL host so a
// Spotify/YouTube embed isn't mis-sized as SoundCloud.
interface Props {
  title?: string;
  label?: string;
  provider?: string;
  embedUrl: string;
}
const { title, label, embedUrl } = Astro.props;
const provider =
  Astro.props.provider ??
  (/open\.spotify\.com/.test(embedUrl) ? "spotify"
    : /youtube\.com|youtu\.be/.test(embedUrl) ? "youtube"
    : "soundcloud");
const klass =
  provider === "youtube" ? "embed video"
  : provider === "spotify" ? "embed audio-tall"
  : "embed audio";
const allow =
  provider === "youtube"
    ? "accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    : "clipboard-write; encrypted-media; fullscreen; picture-in-picture";
---
<div class={klass}>
  {title && <h3>{title}</h3>}
  <iframe
    src={embedUrl}
    title={title ?? label ?? "embedded media"}
    loading="lazy"
    allow={allow}
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
