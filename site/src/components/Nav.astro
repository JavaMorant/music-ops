---
import site from "../../content/site.json";
import sets from "../../content/sets.json";
import photos from "../../content/photos.json";
import productions from "../../content/productions.json";
import dates from "../../content/dates.json";
import collab from "../../content/collab.json";

// Only link to sections that actually render (mirror index.astro's gating).
const links = [
  { href: "#about", label: "About" },
  sets.items?.some((s) => s.embedUrl) && { href: "#sets", label: "Sets" },
  photos.items?.some((p) => p.src) && { href: "#photos", label: "Photos" },
  productions.items?.some((p) => p.embedUrl || p.link) && { href: "#productions", label: "Productions" },
  (dates.upcoming?.length > 0 || dates.past?.length > 0) && { href: "#dates", label: "Dates" },
  { href: "#booking", label: "Booking" },
  Boolean(collab.heading) && { href: "#collab", label: "Collab" },
  { href: "#press", label: "Press kit" },
].filter(Boolean);
---
<nav class="nav">
  <div class="wrap">
    <a class="brand" href="#top">{site.name}</a>
    <div class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
</nav>
