---
import Base from "../layouts/Base.astro";
import Embed from "../components/Embed.astro";
import site from "../../content/site.json";
import stats from "../../content/stats.json";
import dates from "../../content/dates.json";
import sets from "../../content/sets.json";
import photos from "../../content/photos.json";
import productions from "../../content/productions.json";
import collab from "../../content/collab.json";
import highlights from "../../content/highlights.json";

// Bio is markdown so it can hold formatting; render it natively.
const bioMods = import.meta.glob("../../content/bio.md", { eager: true });
const Bio = (Object.values(bioMods)[0] as any)?.Content;

const fmt = (iso: string) => {
  const d = new Date(`${iso}T00:00:00`);
  return isNaN(d.getTime())
    ? iso || "TBA"
    : new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);
};

// Every section below the hero hides itself until its content file has
// something real in it, so an unfinished section never reaches the live page.
const liveSets = (sets.items ?? []).filter((s) => s.embedUrl);
const hasSets = liveSets.length > 0;
const gallery = (photos.items ?? []).filter((p) => p.src);
const hasPhotos = gallery.length > 0;
const releases = (productions.items ?? []).filter((p) => p.embedUrl || p.link);
const hasProductions = releases.length > 0;
const hasHighlights = highlights.items?.length > 0;
const hasUpcoming = dates.upcoming?.length > 0;
const hasPast = dates.past?.length > 0;
const hasCollab = Boolean(collab.heading);
const instagram = site.socials.find((s) => /instagram/i.test(s.label));
const cover = "/photos/01-cover-on-the-decks.jpg";
---
<Base>
  <!-- HERO — press kit cover: full-bleed photo, name, links, rule, contact -->
  <section class="hero" aria-labelledby="hero-h">
    <img class="cover" src={cover} alt={`${site.name} on the decks`} width="1242" height="1080" fetchpriority="high" />
    <div class="wrap">
      <h1 id="hero-h">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="links">
        {site.socials.map((s) => (
          <a class="ulink" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
        {hasSets && <a class="ulink" href="#sets">Sets</a>}
        <a class="ulink" href="/press-kit.zip" download>Press kit</a>
      </div>
      <div class="rule" role="presentation"></div>
      <div class="contact">
        <a href={`mailto:${site.bookingEmail}?subject=${encodeURIComponent(`Booking enquiry — ${site.name}`)}`}>{site.bookingEmail}</a>
        <span>{site.location}</span>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" aria-labelledby="about-h">
    <div class="wrap">
      <h2 id="about-h">About me</h2>
      <div class="bio">{Bio ? <Bio /> : <p>{site.tagline}</p>}</div>
    </div>
  </section>

  <!-- SETS — appears once sets.json has an embedUrl -->
  {hasSets && (
    <section id="sets" aria-labelledby="sets-h">
      <div class="wrap">
        <h2 id="sets-h">Sets</h2>
        <div class="sets">
          {liveSets.map((s) => (
            <div class="set">
              {s.lane && <p class="lane">{s.lane}</p>}
              <Embed title={s.title || s.lane} provider={s.provider} embedUrl={s.embedUrl} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PHOTOS — press kit p.3 mosaic -->
  {hasPhotos && (
    <section id="photos" aria-labelledby="photos-h">
      <div class="wrap">
        <h2 id="photos-h">Photos</h2>
        <div class="gallery">
          {gallery.map((p) => (
            <img class={p.orientation ?? "portrait"} src={p.src} alt={p.alt ?? ""} loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PRODUCTIONS (hidden until content) -->
  {hasProductions && (
    <section id="productions" aria-labelledby="productions-h">
      <div class="wrap">
        <h2 id="productions-h">Productions</h2>
        <div class="embed-grid">
          {releases.map((p) => (
            <div class="release">
              <div class="release-head">
                <span class="rtitle">{p.title}</span>
                <span class="rmeta">{[p.role, p.year].filter(Boolean).join(" · ")}</span>
              </div>
              {p.embedUrl && <Embed label={p.title} provider={p.provider} embedUrl={p.embedUrl} />}
              {p.link && (
                <a class="open-link" href={p.link} target="_blank" rel="noopener noreferrer">
                  {p.embedUrl ? "Open on platform ↗" : "Listen ↗"}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- HIGHLIGHTS (hidden until content) -->
  {hasHighlights && (
    <section id="watch" aria-labelledby="watch-h">
      <div class="wrap">
        <h2 id="watch-h">Watch</h2>
        <div class="embed-grid">
          {highlights.items.map((h) => (
            <Embed title={h.title} provider="youtube" embedUrl={h.embedUrl} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- STATS -->
  {stats.items?.length > 0 && (
    <section id="stats" aria-labelledby="stats-h">
      <div class="wrap">
        <h2 id="stats-h">Numbers</h2>
        <div class="stats">
          {stats.items.map((s) => (
            <div class="stat"><div class="v">{s.value}</div><div class="l">{s.label}</div></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- DATES (hidden until content) -->
  {(hasUpcoming || hasPast) && (
    <section id="dates" aria-labelledby="dates-h">
      <div class="wrap dates">
        <h2 id="dates-h">Dates</h2>
        {hasUpcoming && (
          <>
            <h3>Upcoming</h3>
            {dates.upcoming.map((d) => (
              <div class="date">
                <span class="when">{fmt(d.date)}</span>
                <span class="what">{d.event}<span class="where"> · {d.venue}, {d.city}</span></span>
                {d.ticketUrl
                  ? <a class="tix" href={d.ticketUrl} target="_blank" rel="noopener noreferrer">Tickets</a>
                  : <span class="where">—</span>}
              </div>
            ))}
          </>
        )}
        {hasPast && (
          <>
            <h3 style="margin-top:36px">Past</h3>
            {dates.past.map((d) => (
              <div class="date past">
                <span class="when">{fmt(d.date)}</span>
                <span class="what">{d.event}<span class="where"> · {d.venue}, {d.city}</span></span>
                <span class="where"></span>
              </div>
            ))}
          </>
        )}
      </div>
    </section>
  )}

  <!-- BOOKING -->
  <section id="booking" aria-labelledby="booking-h">
    <div class="wrap">
      <h2 id="booking-h">Booking</h2>
      <div class="booking">
        <p class="big">Club nights, student events, festivals, brand and private bookings. Opening, closing or peak time.</p>
        <p class="dim">Every enquiry is read and answered personally.</p>
        <div class="btn-row">
          <a class="btn" href={`mailto:${site.bookingEmail}?subject=${encodeURIComponent(`Booking enquiry — ${site.name}`)}`}>
            Email for bookings
          </a>
          {instagram && (
            <a class="btn ghost" href={instagram.url} target="_blank" rel="noopener noreferrer">Instagram</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- COLLABORATE (hidden until collab.json has a heading) -->
  {hasCollab && (
    <section id="collab" aria-labelledby="collab-h">
      <div class="wrap">
        <h2 id="collab-h">Collaborate</h2>
        <div class="booking">
          <p class="big">{collab.heading}</p>
          {collab.blurb && <p class="dim">{collab.blurb}</p>}
          {collab.offers?.length > 0 && (
            <ul class="offers">{collab.offers.map((o) => <li>{o}</li>)}</ul>
          )}
          <div class="btn-row">
            <a class="btn" href={`mailto:${site.collabEmail ?? site.bookingEmail}?subject=${encodeURIComponent(`Collab / production — ${site.name}`)}`}>
              Send a track or idea
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- PRESS KIT -->
  <section id="press" aria-labelledby="press-h">
    <div class="wrap">
      <h2 id="press-h">Press kit</h2>
      <div class="booking">
        <p class="big">Bio, press photos and the three-page press kit in one download.</p>
        <div class="btn-row">
          <a class="btn" href="/press-kit.zip" download>Download press kit (.zip)</a>
        </div>
      </div>
    </div>
  </section>
</Base>
